<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- IMAP/SMTP bağlantıları için zorunlu. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Çevrimdışı durumunu algılamak ve bağlantı gelince eşitlemek için. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Android 13+ bildirim izni. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Sesli yazma. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- Yeni ileti oluştururken kamerayla fotoğraf çekmek için. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- Arka plan eşitlemesinin yeniden başlatmadan sonra da sürmesi için. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Büyük eklerin indirilmesi sırasında işin kesilmemesi için. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Ayarlar > Bildirimler'den kullanıcı isteğiyle pil optimizasyonundan
         hariç tutma dialogu açmak için (bkz. NotificationsSettingsScreen).
         Play Console'a yüklenirken "temel işlev" gerekçesi beyan edilmesi
         gerekir. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- Anlık bildirim: uygulama kapalıyken de Gelen Kutusu'nu IMAP IDLE ile
         dinleyen ön plan servisi (bkz. lib/app/push_service.dart). Android 14+
         her ön plan servisi için bir tür ve o türe ait izin ister. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>

    <application
        android:label="Kaydet"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Anlık bildirim servisinin durum çubuğu simgesi
             (bkz. PushService._iconMetaData). Ad birebir aynı olmalı. -->
        <meta-data
            android:name="tr.com.pazarlik.kaydet.push_icon"
            android:resource="@drawable/ic_stat_kaydet" />

        <!-- Uyarı: servis adı değiştirilmemeli, flutter_foreground_task bunu
             sabit bir adla başlatır. `dataSync` türü Android 15'te 24 saatte
             6 saatle sınırlıdır ve sürekli IDLE için uygun değildir; bu
             yüzden `specialUse` kullanılır. Play Console'a yüklenirken bu
             kullanım gerekçesi beyan edilmelidir. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Persistent IMAP IDLE connection that delivers new-mail notifications instantly" />
        </service>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Sesli yazma: cihazdaki konuşma tanıma servisini bulmak için. -->
        <intent>
            <action android:name="android.speech.RecognitionService"/>
        </intent>
        <!-- Ekleri harici uygulamada açabilmek için. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="*/*"/>
        </intent>
    </queries>
</manifest>
