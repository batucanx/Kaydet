<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Uzantı ile ana uygulamanın ortak dosya alanı (bkz. ShareInbox.swift).
	     Runner.entitlements'taki değerle BİREBİR aynı olmalı ve Apple Developer
	     hesabında (Identifiers → App Groups) tanımlı olmalıdır. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.tr.com.pazarlik.kaydet</string>
	</array>
</dict>
</plist>
