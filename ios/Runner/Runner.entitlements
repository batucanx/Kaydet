<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>$(APS_ENVIRONMENT)</string>
	<!-- Share Extension ile ortak dosya alani (bkz. Shared/ShareInbox.swift).
	     ShareExtension.entitlements'taki degerle BIREBIR ayni olmali ve Apple
	     Developer hesabinda (Identifiers > App Groups) tanimli olmalidir. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.tr.com.pazarlik.kaydet</string>
	</array>
</dict>
</plist>
