  "validation": [
    {
      "name": "one relocation with labels and forwards is fine",
      "actions": [
        {
          "type": "forward",
          "email": "muhasebe@example.com"
        },
        {
          "type": "label",
          "labelId": "l1"
        },
        {
          "type": "move",
          "folderId": "f1"
        }
      ],
      "ownAddresses": [],
      "expect": []
    },
    {
      "name": "only one action may take the mail out of the Inbox (move + trash)",
      "actions": [
        {
          "type": "move",
          "folderId": "f1"
        },
        {
          "type": "trash"
        }
      ],
      "ownAddresses": [],
      "expect": [
        {
          "field": "actions.1",
          "reason": "conflict"
        }
      ]
    },
    {
      "name": "only one action may take the mail out of the Inbox (spam + delete)",
      "actions": [
        {
          "type": "spam"
        },
        {
          "type": "delete"
        }
      ],
      "ownAddresses": [],
      "expect": [
        {
          "field": "actions.1",
          "reason": "conflict"
        }
      ]
    },
    {
      "name": "the same label twice is a duplicate",
      "actions": [
        {
          "type": "label",
          "labelId": "l1"
        },
        {
          "type": "label",
          "labelId": "l1"
        }
      ],
      "ownAddresses": [],
      "expect": [
        {
          "field": "actions.1",
          "reason": "duplicate"
        }
      ]
    },
    {
      "name": "two different labels are fine",
      "actions": [
        {
          "type": "label",
          "labelId": "l1"
        },
        {
          "type": "label",
          "labelId": "l2"
        }
      ],
      "ownAddresses": [],
      "expect": []
    },
    {
      "name": "a forward address must be an address",
      "actions": [
        {
          "type": "forward",
          "email": "not-an-address"
        }
      ],
      "ownAddresses": [],
      "expect": [
        {
          "field": "actions.0.email",
          "reason": "invalid"
        }
      ]
    },
    {
      "name": "a filter may not forward to the account itself",
      "actions": [
        {
          "type": "forward",
          "email": "Me@Kaydet.app"
        }
      ],
      "ownAddresses": [
        "me@kaydet.app"
      ],
      "expect": [
        {
          "field": "actions.0.email",
          "reason": "invalid"
        }
      ]
    },
    {
      "name": "two forwards are one too many",
      "actions": [
        {
          "type": "forward",
          "email": "a@example.com"
        },
        {
          "type": "forward",
          "email": "b@example.com"
        }
      ],
      "ownAddresses": [],
      "expect": [
        {
          "field": "actions.1",
          "reason": "too_many"
        }
      ]
    },
    {
      "name": "the same address forwarded twice: too many and a duplicate",
      "actions": [
        {
          "type": "forward",
          "email": "a@example.com"
        },
        {
          "type": "forward",
          "email": "A@Example.com"
        }
      ],
      "ownAddresses": [],
      "expect": [
        {
          "field": "actions.1",
          "reason": "too_many"
        },
        {
          "field": "actions.1",
          "reason": "duplicate"
        }
      ]
    }
  ]
}
