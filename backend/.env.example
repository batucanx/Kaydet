# Sunucu
PORT=8080
HOST=0.0.0.0

# Uygulamanın backend'e istek atarken gönderdiği paylaşılan anahtar
# (uzun, rastgele: `openssl rand -hex 32`)
API_KEY=

# IMAP şifrelerini şifrelemek için 32 baytlık anahtar, hex (64 karakter):
# `openssl rand -hex 32`. Kaybedilirse kayıtlı şifreler çözülemez.
ENCRYPTION_KEY=

# SQLite dosyası
DATABASE_PATH=./data/kaydet.sqlite

# APNs (Apple Developer -> Keys -> APNs Auth Key)
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=tr.com.pazarlik.kaydet

# Mail çevirisi (Microsoft Azure AI Translator, F0 ücretsiz katman).
# Anahtar boşsa ya da ENABLED=false ise çeviri TRANSLATION_UNAVAILABLE döner;
# önbellekteki çeviriler yine sunulur. Anahtar YALNIZCA burada (ya da
# sunucunun secret deposunda) durur, Flutter uygulamasına asla konmaz.
AZURE_TRANSLATOR_ENABLED=true
# Global kaynak: https://api.cognitive.microsofttranslator.com
# Özel alan adlı kaynak: https://<ad>.cognitiveservices.azure.com
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com
AZURE_TRANSLATOR_KEY=
# Portal → Keys and Endpoint → "Location/Region" (ör. westeurope). Bölgesel
# kaynakta zorunlu; global kaynakta boş bırakılabilir.
AZURE_TRANSLATOR_REGION=northeurope
# F0 ücretsiz kota 2.000.000 karakter/ay: güvenlik payı bırakılır.
# Geliştirmede küçük bir değer kullan (ör. AZURE_TRANSLATOR_MONTHLY_LIMIT=10000).
AZURE_TRANSLATOR_MONTHLY_LIMIT=1800000
AZURE_TRANSLATOR_WARNING_LIMIT=1600000
# Kullanıcı (kurulum) başına aylık sınır; genel sınırdan bağımsız denetlenir.
AZURE_TRANSLATOR_USER_MONTHLY_LIMIT=200000
# Tek mailde (konu + metin) çevrilebilecek en çok karakter.
AZURE_TRANSLATOR_MAX_REQUEST_CHARS=100000

# --- Yalnızca `npm run smoke` (IMAP deneme betiği) için ---
SMOKE_IMAP_HOST=imap.gmail.com
SMOKE_IMAP_PORT=993
SMOKE_IMAP_SECURE=true
SMOKE_IMAP_USER=
SMOKE_IMAP_PASS=
