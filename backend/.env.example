# Sunucu
PORT=8080
HOST=0.0.0.0

# Uygulamanın backend'e istek atarken gönderdiği paylaşılan anahtar
# (uzun, rastgele: `openssl rand -hex 32`)
API_KEY=

# IMAP şifrelerini şifrelemek için 32 baytlık anahtar, hex (64 karakter):
# `openssl rand -hex 32`. Kaybedilirse kayıtlı şifreler çözülemez.
ENCRYPTION_KEY=

# SQLite dosyası
DATABASE_PATH=./data/kaydet.sqlite

# APNs (Apple Developer -> Keys -> APNs Auth Key)
APNS_KEY_PATH=./AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=tr.com.pazarlik.kaydet

# --- Yalnızca `npm run smoke` (IMAP deneme betiği) için ---
SMOKE_IMAP_HOST=imap.gmail.com
SMOKE_IMAP_PORT=993
SMOKE_IMAP_SECURE=true
SMOKE_IMAP_USER=
SMOKE_IMAP_PASS=
